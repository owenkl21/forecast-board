# Copy to .env for local runs. On Vercel, set BOARD_PINS, BOARD_HUB_TOKEN and the two
# UPSTASH_ settings under the project's Environment Variables.
# PINs are per player. Hand each person only their own.
BOARD_PINS='{"Owen":"0000","Tristan":"0000","William":"0000","Ian":"0000","Brendan":"0000"}'
# The hub sends this as a bearer token. Make it long and random, and put the same value in
# the hub's ~/.board.env as BOARD_HUB_TOKEN.
BOARD_HUB_TOKEN=change-me
# Hosted storage, from the Upstash console. Leave both unset to keep files on disk instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Local disk storage, used only when the two settings above are unset.
BOARD_DATA=./data
